<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#E6101014"
	android:orientation="horizontal"
	android:padding="24dp">

	<!-- Selected media thumbnail, shown large so a row is easy to confirm at a glance. -->
	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/settings_title"
			android:textColor="#FFFFFF"
			android:textSize="30sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/settings_hint"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:textColor="#B0FFFFFF"
			android:textSize="17sp" />

		<ScrollView
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_marginTop="16dp"
			android:layout_weight="1">

			<LinearLayout
				android:id="@+id/settings_list"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical" />
		</ScrollView>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="16dp"
			android:orientation="horizontal">

			<Button
				android:id="@+id/settings_rebind"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="@string/settings_rebind" />

			<Button
				android:id="@+id/settings_reset"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_weight="1"
				android:text="@string/settings_reset" />

			<Button
				android:id="@+id/settings_close"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_marginStart="12dp"
				android:layout_weight="1"
				android:text="@string/settings_close" />
		</LinearLayout>
	</LinearLayout>

	<!-- Large preview of whatever row is selected. -->
	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_marginStart="24dp"
		android:layout_weight="1"
		android:orientation="vertical">

		<ImageView
			android:id="@+id/settings_preview"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:background="@color/app_background"
			android:contentDescription="@string/settings_preview"
			android:scaleType="fitCenter" />

		<TextView
			android:id="@+id/settings_preview_name"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:gravity="center"
			android:textColor="#FFFFFF"
			android:textSize="22sp" />
	</LinearLayout>

</LinearLayout>